{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hm27651/archive-plex-anime/toolchain/manifest.schema.json",
  "title": "archive-plex-anime toolchain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "generated_contract_version",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_contract_version": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "entrypoint": {
      "type": "string",
      "enum": ["cli", "skill", "hub"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "label"],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "architecture",
        "artifact_url",
        "filename",
        "sha256",
        "size",
        "archive_format",
        "executable_paths"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": ["windows", "linux"]
        },
        "architecture": {
          "type": "string",
          "enum": ["x64", "amd64", "arm64"]
        },
        "artifact_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "archive_format": {
          "type": "string",
          "enum": ["zip", "7z", "tar.xz", "tar.gz"]
        },
        "executable_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "name",
        "purpose",
        "entrypoints",
        "path_kind",
        "path_setting",
        "executables",
        "project_url",
        "download_page_url",
        "binary_source_url",
        "license",
        "capability_checks",
        "artifacts"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entrypoint"
          }
        },
        "path_kind": {
          "type": "string",
          "enum": ["file", "directory"]
        },
        "path_setting": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "executables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "project_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "download_page_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "binary_source_url": {
          "type": ["string", "null"],
          "pattern": "^https://"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "capability_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  }
}
